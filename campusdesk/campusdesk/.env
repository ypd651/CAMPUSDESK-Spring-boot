# Shared by docker-compose (variable substitution) and by the Spring Boot app when run from the IDE.
# This file is ignored by Git. Copy .env.example to create it on another machine.

# ==========================================
# 🗄️ POSTGRESQL & PGADMIN (Docker)
# ==========================================
POSTGRES_DB=NOMBRE_DE_TU_DB
POSTGRES_USER=TU_USER
POSTGRES_PASSWORD=TU_CONTRASEÑA
POSTGRES_PORT=5432

PGADMIN_EMAIL=EMAIL_POSTGRES # Ejemplo: admin@admin.com
PGADMIN_PASSWORD=CONTRASEÑA_POSTGRES

# ==========================================
# ⚙️ BACKEND (Spring Boot)
# ==========================================
PORT=8080
# Usar 'localhost' si ejecutas desde el IDE, o 'postgres' (nombre del servicio) si usas docker-compose
DB_HOST=localhost

# Configuración de Seguridad y JWT
JWT_SECRET=[TU_SECRET_JWT_AQUI]
JWT_ISSUER=campusdesk
JWT_EXPIRATION=8h

# Credenciales del Administrador Inicial
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@technova.local # Correo de tu preferencia para ingreso
ADMIN_PASSWORD=TU_CONTRASEÑA # Contraseña de tu preferencia para entrar

# Configuración de CORS (Separa múltiples orígenes con comas si es necesario)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://localhost:5173
