# Copy to ".env" and set your own values. ".env" is ignored by Git.
POSTGRES_DB=campus_db
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=change-me

# JWT signing key, 32+ characters. Generate one: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-32-chars-or-more
JWT_ISSUER=campusdesk
JWT_EXPIRATION=8h
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@technova.local
# 8+ chars with upper case, lower case, number and symbol
ADMIN_PASSWORD=Replace-Me-123!
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
