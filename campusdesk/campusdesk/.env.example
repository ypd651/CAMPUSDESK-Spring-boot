# ==============================================================================
# CampusDesk - Archivo de Configuración de Variables de Entorno (.env)
# 
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a '.env'
# 2. Reemplaza los valores entre corchetes [] con tu configuración personal.
# 3. NUNCA subas el archivo '.env' real a ningún repositorio Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🗄️ BASE DE DATOS (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=[NOMBRE_DE_TU_BASE_DE_DATOS]      # Ejemplo: campusdesk_db
POSTGRES_USER=[USUARIO_DE_BASE_DE_DATOS]     # Ejemplo: postgres_admin
POSTGRES_PASSWORD=[CONTRASEÑA_DE_TU_BD]      # Ejemplo: MiPasswordSeguro123!

# ------------------------------------------------------------------------------
# 🖥️ ADMINISTRACIÓN DE BASE DE DATOS (pgAdmin 4)
# ------------------------------------------------------------------------------
PGADMIN_EMAIL=[CORREO_PGADMIN]               # Ejemplo: admin@campusdesk.local
PGADMIN_PASSWORD=[CONTRASEÑA_PGADMIN]        # Ejemplo: AdminPgPass123!

# ------------------------------------------------------------------------------
# ⚙️ AUTENTICACIÓN Y SEGURIDAD (Backend / Spring Boot)
# ------------------------------------------------------------------------------
# Clave secreta para firmar tokens JWT. Debe ser una cadena aleatoria y robusta.
# Puedes generarla ejecutando en consola: openssl rand -base64 64
JWT_SECRET=[TU_SECRET_JWT_AQUI]

JWT_ISSUER=campusdesk                        # Emisor del token
JWT_EXPIRATION=8h                            # Tiempo de validez del token (ej. 8h, 24h)

# ------------------------------------------------------------------------------
# 👤 USUARIO ADMINISTRADOR INICIAL
# ------------------------------------------------------------------------------
ADMIN_FULL_NAME=System Administrator         # Nombre completo del administrador inicial
ADMIN_EMAIL=[CORREO_ADMIN_PLATAFORMA]        # Ejemplo: admin@technova.local
ADMIN_PASSWORD=[CONTRASEÑA_ADMIN_PLATAFORMA] # Contraseña inicial para iniciar sesión en el sistema

# ------------------------------------------------------------------------------
# 🌐 CONFIGURACIÓN DE RED Y CORS
# ------------------------------------------------------------------------------
# Orígenes permitidos para peticiones desde el navegador (separados por comas)
# Nota: Incluye el puerto 8081 o 8080 según cómo accedas al backend o frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
