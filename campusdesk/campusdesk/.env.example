# Copy this file to ".env" and replace every value. ".env" is ignored by Git; this example only holds placeholders.
# Generate a JWT secret with:  openssl rand -base64 48

# --- PostgreSQL / pgAdmin ---
POSTGRES_DB=campusdesk_db
POSTGRES_USER=change_me_user
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_PORT=5432
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin_password

# --- Backend ---
PORT=8080
DB_HOST=localhost
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_characters
JWT_ISSUER=campusdesk
JWT_EXPIRATION=8h

# --- First administrator (created on startup if missing) ---
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_Admin_1!

# --- CORS: origins allowed to call the API ---
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://localhost:5173
